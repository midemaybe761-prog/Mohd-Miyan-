PORT=5000
NODE_ENV=production
JWT_SECRET=super_secret_ai_video_studio_jwt_token_2026

# External AI Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
RUNWAY_API_KEY=your_runway_gen3_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# FFmpeg Path (if custom)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Database Configuration (Supabase / PostgreSQL / Firebase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aivideostudio
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Storage Directory for Rendered Videos
MEDIA_STORAGE_DIR=./public/outputs
